# ==========================================
# Agent Knowledge Base 环境变量配置模板
# 使用说明：复制此文件并重命名为 .env，然后根据实际情况修改
# ==========================================

# --- 1. LLM API 密钥（可选） ---
# 如果后续 Agent 接入 OpenAI 模型，请在此填入您的密钥
# 如果全程使用本地 Ollama，可留空
# OPENAI_API_KEY=your_openai_api_key_here

# --- 2. 本地 Ollama 嵌入模型配置（当前核心） ---
# 本项目默认使用 Ollama 提供的本地 Embedding 模型
EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_BASE_URL=http://localhost:11434

# --- 3. 向量数据库配置 ---
# 向量库的本地持久化存储路径（Chroma 会在该目录下创建数据库文件）
VECTOR_STORE_PATH=./data/chroma

# --- 4. 文档切分与检索配置 ---
# 文档切分时的块大小和重叠长度
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# 检索时默认返回的文档片段数量
TOP_K=5

# --- 5. 数据源目录 ---
# 原始文档存放目录（需手动放入 .txt 等文档）
RAW_DIR=./data/raw